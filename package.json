{
	"name": "pwdg",
	"packageManager": "pnpm@10.28.2",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && tsc --noEmit && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"typecheck": "astro check && tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write src/**"
	},
	"dependencies": {
		"@astrojs/check": "0.9.6",
		"@astrojs/solid-js": "5.1.3",
		"@tailwindcss/vite": "4.2.1",
		"astro": "5.18.0",
		"astro-robots-txt": "1.0.0",
		"solid-js": "1.9.11",
		"solid-toast": "0.5.0",
		"tailwindcss": "4.2.1"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "1.10.6",
		"@eslint/js": "10.0.1",
		"@types/node": "25.3.5",
		"eslint": "10.0.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-astro": "1.6.0",
		"globals": "17.4.0",
		"prettier": "3.8.1",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.56.1"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"@babel/core",
				"eslint-plugin-react"
			]
		},
		"overrides": {
			"lodash": "^4.17.23"
		}
	},
	"engines": {
		"node": "24.x"
	}
}
